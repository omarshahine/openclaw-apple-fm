{
  "name": "openclaw-apple-fm",
  "version": "0.1.1",
  "description": "OpenClaw node-host plugin that runs Apple Foundation Models (on-device) on a paired macOS 27 node",
  "type": "module",
  "license": "MIT",
  "author": "Omar Shahine",
  "files": [
    "dist/",
    "src/",
    "native/",
    "openclaw.plugin.json",
    "marketplace.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "sh scripts/build.sh",
    "prepack": "npm run build",
    "test": "node --import ./test/ts-resolve.mjs --test test/",
    "typecheck": "sh scripts/typecheck.sh",
    "check": "npm run typecheck && npm test",
    "smoke": "node scripts/smoke.mjs",
    "plugin:check": "npx --yes @openclaw/plugin-inspector inspect --no-openclaw"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/omarshahine/openclaw-apple-fm.git"
  },
  "homepage": "https://github.com/omarshahine/openclaw-apple-fm#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "apple",
    "foundation-models",
    "on-device",
    "ocr",
    "macos",
    "privacy"
  ]
}
